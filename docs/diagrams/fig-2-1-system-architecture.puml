@startuml fig_2_1_system_architecture
title Рисунок 2.1 — Компонентная архитектура системы Refocus

skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "Пользователь" as User

package "Слой представления (Frontend)" as FE #E8F4FC {
  component [Клиентское приложение\n----\nNext.js, React, TypeScript\nTailwind CSS] as UI
}

package "Слой приложения (Backend)" as BE #EDF5FB {
  component [Сервер приложения\n----\nNode.js, Next.js App Router] as Server
  component [API-маршруты\n/api/auth, /patient, /doctor,\n/manager, /admin] as API
  component [Модули lib\nвалидация, сессия, расписание,\nзагрузка файлов] as Lib
  component [Prisma ORM\nbcryptjs] as Prisma
}

package "Слой данных (Data)" as DA #F4F4F4 {
  database "PostgreSQL 16" as PG
  folder "uploads/" as FS
}

User --> UI : <<HTTPS>>

UI --> API : <<HTTP/HTTPS>>\nJSON\n+ cookie сессии

API --> Lib
Lib --> Prisma
API --> Prisma

Prisma --> PG : <<SQL>>\nTCP, порт 5432

Lib --> FS : файловая система\n(чтение/запись)

API --> FS : выдача PDF\nчерез HTTP-ответ

note right of FE
  Frontend: интерфейсы ролей
  PATIENT, DOCTOR, MANAGER,
  SYSTEM_ADMIN
end note

note right of BE
  Backend: аутентификация,
  авторизация, бизнес-правила,
  работа с БД и файлами
end note

note right of DA
  Data: реляционные данные
  и бинарные файлы (PDF, фото)
end note

@enduml

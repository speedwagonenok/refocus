@startuml fig_3_3_components
title Рисунок 3.3 — Компонентная структура реализации Refocus
skinparam shadowing false
skinparam componentStyle rectangle

package "Клиент (браузер)" as ClientPkg {
  component "PatientWorkspacePanel" as PWP
  component "DoctorWorkspacePanel" as DWP
  component "ManagerPanel" as MP
  component "SuperadminPanel" as SAP
  component "LoginWindow" as LoginUI
  component "RegistrationWindow" as RegUI
}

package "Next.js App Router" as NextPkg {
  package "Страницы" as PagesPkg {
    component "user/[id]/page" as UserPage
    component "admin/page" as AdminPage
  }
  package "API Route Handlers" as ApiPkg {
    component "api/auth" as AuthAPI
    component "api/patient" as PatAPI
    component "api/doctor" as DocAPI
    component "api/manager" as MgrAPI
    component "api/admin" as AdmAPI
  }
}

package "lib" as LibPkg {
  component "sessionUser" as Sess
  component "authValidation" as Valid
  component "scheduleTime" as SchedLib
  component "uploads helpers" as FilesLib
  component "doctorSymptomsJson" as MatchLib
  component "prisma" as PrismaLib
}

database "PostgreSQL" as PG
folder "uploads" as FS

LoginUI --> AuthAPI
RegUI --> AuthAPI
PWP --> PatAPI
DWP --> DocAPI
MP --> MgrAPI
SAP --> AdmAPI
UserPage --> Sess
AdminPage --> Sess

AuthAPI --> Valid
AuthAPI --> PrismaLib
PatAPI --> Sess
PatAPI --> MatchLib
PatAPI --> SchedLib
PatAPI --> PrismaLib
DocAPI --> Sess
DocAPI --> FilesLib
DocAPI --> PrismaLib
MgrAPI --> Sess
MgrAPI --> FilesLib
MgrAPI --> PrismaLib
AdmAPI --> Sess
AdmAPI --> PrismaLib

PrismaLib --> PG
FilesLib --> FS

@enduml

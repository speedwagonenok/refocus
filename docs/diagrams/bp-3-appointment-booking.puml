@startuml bp_3_appointment_booking
title БП-3. Запись на приём и согласование статуса

skinparam shadowing false

|Пациент|
start
:Выбрать врача;
repeat
  :Выбрать свободный слот\nи указать телефон;

|Система|
  :Проверить доступность слота;
repeat while (Слот занят/недоступен?) is (да)

|Система|
:Создать заявку\nсо статусом PENDING;

|Менеджер|
:Просмотреть заявку;
if (Решение менеджера) then (Подтвердить)
  |Система|
  :Статус заявки = CONFIRMED;
  |Пациент|
  :Статус = CONFIRMED;
  |Врач|
  :Слот отмечен как подтверждённый;
  stop
else (Отменить)
  |Система|
  :Статус заявки = CANCELLED;
  |Пациент|
  :Статус = CANCELLED;
  stop
endif

@enduml

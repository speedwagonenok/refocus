@startuml bp_2_doctor_matching
' БП-2 — Подбор специалиста и работа с каталогом
' Рисунок 1.4 (после выравнивания с табл. 1.3)
title БП-2. Подбор специалиста и работа с каталогом

skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFBF0
  BorderColor #D4A574
  FontSize 12
}

|Пациент|
start
:Войти в личный кабинет;

if (Способ выбора врача?) then (Анкета / подбор)
  :Заполнить анкету\n(выбрать симптомы из списка);
  |Система|
  :Сопоставить симптомы\nс профилями врачей;
  :Сформировать список\nрекомендованных специалистов;
  |Пациент|
  :Просмотреть карточки врачей\n(сортировка по цене);
else (Каталог «Все специалисты»)
  |Система|
  :Загрузить каталог врачей;
  |Пациент|
  :Поиск по ФИО,\nсортировка по стоимости;
  :Открыть карточку врача\n(профиль, дипломы, образование);
endif

:Выбрать врача;
:Перейти к записи на приём\n(БП-3);

stop

@enduml

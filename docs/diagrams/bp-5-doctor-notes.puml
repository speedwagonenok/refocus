@startuml bp_5_doctor_notes
' БП-5 — Ведение карточки пациента (врачебные заметки)
' Рисунок 1.7 (после выравнивания с табл. 1.3)
title БП-5. Ведение карточки пациента (врачебные заметки)

skinparam shadowing false
skinparam activity {
  FontSize 12
}

|Врач|
start
:Войти в панель врача;
:Открыть «Мои пациенты»;

|Система|
:Показать пациентов\nс подтверждёнными приёмами\n(CONFIRMED);

|Врач|
:Выбрать пациента;
:Загрузить PDF-заметку;

|Система|
:Проверить право доступа\n(связь врач–пациент через приём);
if (Доступ разрешён?) then (да)
  :Сохранить файл в uploads/;
  :Записать заметку в БД\n(автор, дата);
else (нет)
  :Отказ в доступе;
  stop
endif

|Врач|
:Просмотреть историю заметок\n(общая карточка пациента);

note right
  Заметки разных врачей
  накапливаются в одном разделе
  при наличии связи с пациентом
end note

stop

@enduml
